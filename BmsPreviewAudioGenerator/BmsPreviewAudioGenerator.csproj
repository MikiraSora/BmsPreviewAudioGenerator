<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Version>0.9.9.9</Version>
		<PublishAOT>false</PublishAOT>
		<CetCompat>false</CetCompat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ManagedBass" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Enc" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Flac" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Fx" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Mix" Version="3.1.1" />
		<PackageReference Include="ManagedBass.Opus" Version="3.1.1" />
		<PackageReference Include="Ude.NetStandard" Version="1.2.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\csbms-parser\CSBMSParser\CSBMSParser\CSBMSParser.csproj" />
	</ItemGroup>
	<!-- Native library target OS: use the RuntimeIdentifier prefix (win/linux) when explicitly set, otherwise follow the host system.
	     The publish profile (pubxml) is imported after the project body is evaluated, so static conditions cannot see its RuntimeIdentifier;
	     it must be resolved at execution time. Copying via None item metadata also gets starved by incrementally skipped targets, so copy explicitly -->
	<Target Name="CopyBassNativeLibraries" AfterTargets="Build">
		<PropertyGroup>
			<_BassTargetOs Condition="'$(RuntimeIdentifier)' != ''">$([System.String]::new('$(RuntimeIdentifier)').Split('-')[0])</_BassTargetOs>
			<_BassTargetOs Condition="'$(_BassTargetOs)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</_BassTargetOs>
			<_BassTargetOs Condition="'$(_BassTargetOs)' == ''">win</_BassTargetOs>
			<_BassNativeGlob Condition="'$(_BassTargetOs)' == 'win'">bass*.dll</_BassNativeGlob>
			<_BassNativeGlob Condition="'$(_BassTargetOs)' == 'linux'">libbass*.so</_BassNativeGlob>
		</PropertyGroup>
		<ItemGroup Condition="'$(_BassNativeGlob)' != ''">
			<_BassNativeFiles Include="$(MSBuildProjectDirectory)\$(_BassNativeGlob)" />
		</ItemGroup>
		<Copy SourceFiles="@(_BassNativeFiles)"
			  DestinationFiles="@(_BassNativeFiles->'$(OutDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true"
			  Condition="'@(_BassNativeFiles)' != ''" />
	</Target>
	<Target Name="CopyBassNativeLibrariesToPublish" AfterTargets="ComputeAndCopyFilesToPublishDirectory">
		<PropertyGroup>
			<!-- Fallback re-evaluation for cases where the build-time target may not have run (e.g. no-build publish) -->
			<_BassTargetOs Condition="'$(_BassTargetOs)' == ''">$([System.String]::new('$(RuntimeIdentifier)').Split('-')[0])</_BassTargetOs>
			<_BassTargetOs Condition="'$(_BassTargetOs)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux</_BassTargetOs>
			<_BassTargetOs Condition="'$(_BassTargetOs)' == ''">win</_BassTargetOs>
			<_BassNativeGlob Condition="'$(_BassNativeGlob)' == '' and '$(_BassTargetOs)' == 'win'">bass*.dll</_BassNativeGlob>
			<_BassNativeGlob Condition="'$(_BassNativeGlob)' == '' and '$(_BassTargetOs)' == 'linux'">libbass*.so</_BassNativeGlob>
		</PropertyGroup>
		<ItemGroup Condition="'$(_BassNativeGlob)' != ''">
			<_BassNativeFiles Include="$(MSBuildProjectDirectory)\$(_BassNativeGlob)" />
		</ItemGroup>
		<Copy SourceFiles="@(_BassNativeFiles)"
			  DestinationFiles="@(_BassNativeFiles->'$(PublishDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true"
			  Condition="'@(_BassNativeFiles)' != ''" />
	</Target>
</Project>
